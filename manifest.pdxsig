# svc-wm v1.0.0-src -- release manifest (source form)
#
# This is the human-readable source form of `manifest.pdxsig`. At a
# signed release, the release tool at pkgs.paideia-os mirror-push time
# (a) enumerates the artifact list below, (b) recomputes every
# BLAKE3-256 hash from the repo tree at the release tag, (c) writes the
# completed manifest into a binary `manifest.pdxsig`, and (d) invokes
#   paideia-pq-sign::sign_release_artifact(sk, manifest_path)
# once with the paideia-release-line Ed25519 secret key and once with
# the ML-DSA-65 secret key. Format mirrors svc-compositor's own
# `release/manifest.pdxsig.txt` (this org's Wave F/Y closer template).
#
# v1.0.0-src is the M5 milestone closer (#12) in SOURCE FORM: every
# artifact and cap-kind/syscall contract below is final for 1.0.0, but
# the [signatures] block still stays PLACEHOLDER -- the live dual-sign
# pass (Ed25519 || ML-DSA-65 over this manifest, once every <BLAKE3-*>
# hash below is recomputed at the release tag) is a release-time step
# performed with live key material outside this repo/commit, per this
# org's standing M5 convention (see svc-compositor's own
# release/RELEASE-1.0.0.md §3). This source-form manifest lands at repo
# root starting at M1-001 (#1) and is refreshed at every release tag.
#
# Reference:
#   design/paideia-as/v0.20-issue-1025-pq-signing.md -- Hybrid,
#     sign_release_artifact, HybridSignature (Ed25519 || ML-DSA-65).
#   design/graphics/r102-user-plan.md §4.5              -- svc-wm scope.

format-version:      1
manifest-schema:     paideia-manifest-pdxsig@1
package-name:        svc-wm
package-version:     1.1.0
package-release:     R102-PPP-1.1.0
package-kind:        service
package-license:     MIT
source-repo:         https://github.com/paideia-os/svc-wm
source-commit:       <TAG-v1.1.0-src-COMMIT-SHA>   # release tool fills in
source-tag:          v1.1.0-src

# ---------------------------------------------------------------
# Artifact set -- every file the v0.6.0 tag ships. Hash discipline is
# BLAKE3-256, upper 32 bytes rendered as 64 hex chars. Order is stable
# (lexicographic within each section) so the concatenated hash-input is
# reproducible across signers.
# ---------------------------------------------------------------

[artifacts.source]
src/main.pdx                              blake3-256 = <BLAKE3-main.pdx>
src/tiling.pdx                            blake3-256 = <BLAKE3-tiling.pdx>
src/decoration.pdx                        blake3-256 = <BLAKE3-decoration.pdx>
src/focus.pdx                             blake3-256 = <BLAKE3-focus.pdx>
src/palette.pdx                           blake3-256 = <BLAKE3-palette.pdx>

[artifacts.tests]
tests/README.md                           blake3-256 = <BLAKE3-tests-README.md>
tests/probe_scaffold.pdx                  blake3-256 = <BLAKE3-probe_scaffold.pdx>
tests/probe_wire_protocol.pdx             blake3-256 = <BLAKE3-probe_wire_protocol.pdx>
tests/probe_register.pdx                  blake3-256 = <BLAKE3-probe_register.pdx>
tests/probe_tiling.pdx                    blake3-256 = <BLAKE3-probe_tiling.pdx>
tests/probe_decoration.pdx                blake3-256 = <BLAKE3-probe_decoration.pdx>
tests/svc_wm_tile_smoke.pdx               blake3-256 = <BLAKE3-svc_wm_tile_smoke.pdx>
tests/svc_wm_focus_cycle_smoke.pdx        blake3-256 = <BLAKE3-svc_wm_focus_cycle_smoke.pdx>
tests/svc_wm_palette_smoke.pdx            blake3-256 = <BLAKE3-svc_wm_palette_smoke.pdx>
tests/svc_wm_tile_geometry_smoke.pdx      blake3-256 = <BLAKE3-svc_wm_tile_geometry_smoke.pdx>
tests/svc_wm_decoration_smoke.pdx         blake3-256 = <BLAKE3-svc_wm_decoration_smoke.pdx>
tests/svc_wm_focus_cap_smoke.pdx          blake3-256 = <BLAKE3-svc_wm_focus_cap_smoke.pdx>
tests/svc_wm_palette_matrix_smoke.pdx     blake3-256 = <BLAKE3-svc_wm_palette_matrix_smoke.pdx>

[artifacts.meta]
caps.decl                                 blake3-256 = <BLAKE3-caps.decl>
design/wire-protocol.md                   blake3-256 = <BLAKE3-wire-protocol.md>
STATUS.md                                 blake3-256 = <BLAKE3-STATUS.md>

[artifacts.legal]
LICENSE                                   blake3-256 = <BLAKE3-LICENSE>
README.md                                 blake3-256 = <BLAKE3-README.md>
CHANGELOG.md                              blake3-256 = <BLAKE3-CHANGELOG.md>

# ---------------------------------------------------------------
# Cross-repo dependencies.
# ---------------------------------------------------------------

[depends-on]
# (empty at v0.6.0 -- no satellite library linkage; svc-wm talks to
# svc.compositor purely over the kernel IPC substrate, no shared code.)

[not-linked]
# Named as a wire-protocol peer in this repo's own docs but not a link
# dependency.
svc-compositor            # IPC peer only (svc.compositor.wm control endpoint);
                           # WM_CLOSE_WINDOW (0x12) and WM_BLIT (0x13) are
                           # svc-wm's own forward declarations, not yet frozen
                           # in svc-compositor's own caps.decl (v1.2.0)

# ---------------------------------------------------------------
# Substrate contracts.
# ---------------------------------------------------------------

[substrate]
paideia-as-toolchain      >= 0.24.0-mldsa65-sign
kernel-syscall            = sys_write (1), sys_cap_mint (5, ENOSYS at HEAD --
                            see design/audit/entries/r13-m5-003-syscall-table.md),
                            sys_getpid (39), sys_ipc_recv (40),
                            sys_ipc_reply (41), sys_ipc_send (42),
                            sys_svc_lookup (43)
kernel-cap-kind           = KIND_USER (0x190)          # attribution only
kernel-cap-kind           = KIND_IPC_ENDPOINT (5)
kernel-cap-kind           = KIND_SURFACE (0x1B8)       # referenced, not minted
kernel-cap-kind           = KIND_INPUT_FOCUS (0x1BA)   # local placeholder ordinal;
                                                        # focus_mint call site real,
                                                        # blocked on sys_cap_mint ENOSYS

# ---------------------------------------------------------------
# Signature block -- NOT PERFORMED AT THIS MILESTONE. See
# svc-compositor's release/RELEASE-1.0.0.md §3 for the full rationale
# every M5 closer in this org shares; the real dual-sign pass is a
# release-time step performed with live key material outside this repo.
# ---------------------------------------------------------------

[signatures]
signer-identity      = paideia-release-line
signer-key-source    = design/02-development-environment.md
signature-scheme     = hybrid-ed25519+ml-dsa-65 (paideia-pq-hybrid-v1)
hash-input-algo      = blake3-256
hash-input-domain    = "paideia-release-artifact\x00" || manifest-body-bytes

ed25519-key-id       = SIGNATURE_PLACEHOLDER_PENDING_LIVE_SIGN
ed25519-signature    = SIGNATURE_PLACEHOLDER_PENDING_LIVE_SIGN

ml-dsa-65-key-id     = SIGNATURE_PLACEHOLDER_PENDING_LIVE_SIGN
ml-dsa-65-signature  = SIGNATURE_PLACEHOLDER_PENDING_LIVE_SIGN

# End of manifest.pdxsig source. Refreshed at every release tag; the
# dual-sign pass that fills in [signatures] and every <BLAKE3-*>
# placeholder is a release-time step outside this milestone.

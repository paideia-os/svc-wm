// tests/probe_register.pdx -- svc-wm v1.1.0 (Wave FF: R102.M1-003, #3;
// upgraded Wave PPP: SVC-WM-01)
// ProbeRegister: real-assertion witness for the connect + register
// closer, upgraded from fingerprint-only.
//
// Why this driver still cannot call Main::run directly
// ------------------------------------------------------
// `Main::run` (src/main.pdx) is a REAL body -- sys_svc_lookup/
// sys_ipc_send/sys_ipc_recv are all live in the kernel at Wave FF drain
// -- but exercising it end to end requires a LIVE svc.compositor process
// already registered on svc_broker. This single-process repo smoke has
// no multi-process orchestration, so calling `Main::run` here would
// either deadlock in sys_ipc_recv (waiting for a reply that never
// arrives) or return a deterministic -ENOENT from sys_svc_lookup --
// neither of which is the "compositor round-trip succeeded" claim this
// witness must not fabricate. Separately, every `.pdx` driver in this
// repo (this file included) names its own process entry point `run`;
// linking `src/main.pdx`'s `run` alongside this file's `run` in the same
// smoke binary is its own hazard independent of the live-compositor gap.
// Consistent with this org's honest-witness convention (svc-compositor's
// tests/README.md §"Why honest witness and not rig"), this driver stays
// self-contained: it re-issues the SAME three syscalls `Main::run` makes
// (sys_svc_lookup/sys_ipc_send/sys_ipc_recv, sysnos 43/42/40) directly,
// against a locally-declared copy of the same wire inputs, and asserts
// each one's real, deterministic, environment-verifiable outcome in
// THIS single-process harness: the lookup fails (no live svc.compositor
// registered), and a send/recv issued against cap_slot 0 (never a valid
// slot at this substrate -- Focus module's own convention) are rejected
// by the kernel's capability check before either could block. This is
// the exact boundary Main::run itself would hit at the same call sites,
// verified for real without fabricating the live round trip.
//
// Retargeting path (unchanged): once the monorepo's boot orchestration
// spawns both processes, replace this driver's body with an actual
// `call`-equivalent invocation of Main::run's real connect+register
// path and assert its return value is SWM_MAIN_OK (0) -- see this
// repo's tests/README.md for the multi-process boot smoke this
// currently defers to.

module ProbeRegister = structure {

  pub let probe_register_fp     : [u8; 33] = "svc-wm register-client wired ok\n\0"
  pub let probe_register_fp_len : u64      = 32

  // Local copy of Main's own svc.compositor lookup target (src/main.pdx
  // swm_svc_compositor_name) -- duplicated here rather than referenced
  // cross-module, to keep this driver's link set free of src/main.pdx
  // entirely (see module header "run"/"run" hazard).
  pub let probe_register_svc_name     : [u8; 16] = "svc.compositor\0\0"
  pub let probe_register_svc_name_len : u64      = 14

  pub let mut probe_register_frame_buf : [u8; 64] = uninit @align(8)

  pub let run : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "svc-wm.R102.M1-003 (#3) / PPP.SVC-WM-01: ProbeRegister::run real-assertion witness. push rbx once at entry (rsp%16==8 -> %16==0 -- pure accumulator/callee-save discipline pad; every syscall below is raw, no nested `call`, so no CALL-site alignment obligation is actually incurred, but the push/pop-rbx convention is kept for consistency with this repo's other real-assertion drivers). (1) sys_svc_lookup(&probe_register_svc_name, 14; rax=43); syscall; asserted negative (no live svc.compositor registered in this single-process smoke -- the exact deterministic outcome Main::run's own first step would hit). (2) sys_ipc_send(cap_slot=0, &probe_register_frame_buf, &probe_register_frame_buf+8, 56; rax=42); syscall; asserted negative (cap_slot 0 is never a valid slot at this substrate -- Focus module's own convention -- so the kernel's capability check rejects it before any blocking could occur). (3) sys_ipc_recv(cap_slot=0, same buffers, 56; rax=40); syscall; asserted negative for the identical reason -- an invalid/unregistered slot fails validation immediately rather than arming a wait, so this is safe to assert without risking the deadlock Main::run's OWN recv call (against a real, lookup-derived slot) would risk. rbx accumulates a first-failure code (0 = all three held); `cmp rbx,0; jne probe_register_fail` gates the fingerprint write, unchanged from this driver's original v0.5.0 message. Labels prefixed probe_register_.",
      block: {
        push rbx;
        xor rbx, rbx;

        lea rdi, [rip + probe_register_svc_name];
        mov rsi, 14;
        mov rax, 43;                        // SC+ ID 43 = sys_svc_lookup
        syscall;
        cmp rax, 0;
        jl probe_register_lookup_ok;
        mov rbx, 1;
      probe_register_lookup_ok:

        mov rdi, 0;                         // cap_slot 0 -- never valid
        lea rsi, [rip + probe_register_frame_buf];
        lea rdx, [rip + probe_register_frame_buf + 8];
        mov r10, 56;
        mov rax, 42;                        // SC+ ID 42 = sys_ipc_send
        syscall;
        cmp rax, 0;
        jl probe_register_send_ok;
        mov rbx, 2;
      probe_register_send_ok:

        mov rdi, 0;                         // cap_slot 0 -- never valid
        lea rsi, [rip + probe_register_frame_buf];
        lea rdx, [rip + probe_register_frame_buf + 8];
        mov r10, 56;
        mov rax, 40;                        // SC+ ID 40 = sys_ipc_recv
        syscall;
        cmp rax, 0;
        jl probe_register_recv_ok;
        mov rbx, 3;
      probe_register_recv_ok:

        cmp rbx, 0;
        jne probe_register_fail;

        mov rdi, 1;
        lea rsi, [rip + probe_register_fp];
        mov rdx, 32;
        mov rax, 1;
        syscall;

        pop rbx;
        xor rax, rax;
        ret;

      probe_register_fail:
        mov rax, rbx;
        pop rbx;
        ret;
      }
    }

}
